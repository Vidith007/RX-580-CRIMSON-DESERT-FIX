+    block = root_scratch;
+
+    /* Chunked: one descriptor push and one multi-draw per chunk. The shaders read their
+     * command's root parameter block by DrawIndex, which the multi-draw numbers from 0
+     * within each chunk, so binding the window at the chunk's first block lines the two
+     * up. The compute pass wrote the draw arguments tightly packed, so the multi-draw
+     * stride is just the size of one argument struct. */
