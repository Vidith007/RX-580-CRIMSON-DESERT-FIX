+/* Opt-out lever for the DGC root constant emulation below. Set
+ * VKD3D_DGC_EMULATE_ROOT_CONSTANTS=0 to fall back to issuing the draws with
+ * whatever constant the command list last bound.
+ *
+ * Read with vkd3d_get_env_var, NOT getenv. On Windows the CRT builds its own
+ * environment snapshot at process start and SetEnvironmentVariableA does not
+ * update it, so a var injected by a loaded DLL - which is how every knob in
+ * dx12bridge.ini arrives - is invisible to getenv but visible to
+ * GetEnvironmentVariableA, which is what vkd3d_get_env_var calls on _WIN32
+ * (platform.c:228). Both of these levers originally used getenv and were
+ * therefore inert: an ini setting of 1024 was logged as applied by the shim and
+ * silently ignored here, and a whole capture session was spent measuring a
+ * "change" that was really the old default. If a lever appears to have no
+ * effect, confirm the consumer can see it before believing the result. */
+static bool d3d12_dgc_emulate_root_constants_enabled(void)
+{
+    static int cached = -1;
+    char env[32];
+
+    if (cached < 0)
+    {
+        cached = (vkd3d_get_env_var("VKD3D_DGC_EMULATE_ROOT_CONSTANTS", env, sizeof(env))
+                && strcmp(env, "0") == 0) ? 0 : 1;
+    }
+
+    return cached != 0;
+}
+
+/* Unrolling costs one recorded draw per *max* command count, not per command the
+ * count buffer actually names, so this bound exists to stop a signature handing
+ * out a huge MaxCommandCount from being ruinous to unroll. A batch above the
+ * bound keeps the old fallback, which draws the right geometry but applies none
+ * of the per-command root constants: all N draws see the single root parameter
+ * block the app bound before the call, so N meshes render with one mesh's
+ * transform and material.
+ *
+ * That fallback is the visible bug. Measured over one open-world session at the
+ * old bound of 64:
+ *
+ *   bound=64 calls=1769472 cmds=12268242 (biggest 64)
+ *   rejectRange 65..21341 | ok=1396282 overBound=373278
+ *
+ * cmds counts accepted commands only - "biggest 64" proves it, since the largest
+ * batch seen was 21341 - so 1396282 accepted calls carried 12268242 commands,
+ * averaging 8.8. The 373278 refused calls carried between 65 and 21341 each,
+ * i.e. at least 24.3M commands. The majority of this engine's indirect geometry
+ * was therefore being drawn with a single shared transform, which is what the
+ * frame captures show: stretched thin-sliver triangle nets and light-volume
+ * boxes standing where correctly-placed meshes should be.
+ *
+ * Two earlier figures here were wrong and are kept as method errors:
+ *
+ *   "averaging ~508" came from dividing vkd3d's aggregate indirectMaxTotal by its
+ *   aggregate indirect call count, mixing in vkd3d's own internal indirect work.
+ *   Never size a fix off a ratio of two counters covering different populations.
+ *
+ *   "450,561 calls averaged 1.71 commands and peaked at 13, so the bound never
+ *   fires" was true of the area it was measured in and false of the open world.
+ *   One locale is not a distribution.
+ *
+ * Cost per unrolled command, measured at the call site: 20 bytes of args scratch
+ * (sizeof(uint32_t) * action_words) + 256 bytes of root scratch
+ * (sizeof(union vkd3d_root_parameter_data), see the allocation near :8869), plus
+ * one vkCmdPushDescriptorSetKHR and one vkCmdDraw[Indexed]Indirect recorded. At
+ * 65536 the worst single call is ~18 MB of scratch, which is nothing against
+ * 8 GB, so scratch is not what bounds this - recording time is. The default is
+ * set high enough that overBound reaches 0 in order to establish whether the
+ * fallback is the cause of the broken geometry; the histogram in the tally below
+ * reports the real distribution so the production value can be chosen from data
+ * rather than guessed, and VKD3D_DGC_EMULATE_MAX_COMMANDS now actually works
+ * (see the getenv note above), so it can be lowered without a rebuild. */
+#define VKD3D_DGC_EMULATE_MAX_COMMANDS_DEFAULT 65536u
+
+static uint32_t d3d12_dgc_emulate_max_commands(void)
+{
+    static int64_t cached = -1;
+    char env[32];
+
+    if (cached < 0)
+    {
+        cached = vkd3d_get_env_var("VKD3D_DGC_EMULATE_MAX_COMMANDS", env, sizeof(env))
+                ? strtoul(env, NULL, 0) : VKD3D_DGC_EMULATE_MAX_COMMANDS_DEFAULT;
+    }
+
+    return (uint32_t)cached;
+}
+
+/* Coverage accounting for the bound above. Racy across threads by design: a torn
+ * counter costs a slightly wrong diagnostic, and taking a lock on every indirect
+ * draw to avoid that would cost more than the numbers are worth. */
+enum vkd3d_dgc_emulate_reason
+{
+    VKD3D_DGC_EMULATE_OK = 0,
+    VKD3D_DGC_EMULATE_NO_ROOT_SIGNATURE,
+    VKD3D_DGC_EMULATE_ARG_COUNT,
+    VKD3D_DGC_EMULATE_ARG_TYPE,
+    VKD3D_DGC_EMULATE_OVER_BOUND,
+    VKD3D_DGC_EMULATE_NO_PUSH_UBO,
+    VKD3D_DGC_EMULATE_NOT_ROOT_CONSTANT,
+    VKD3D_DGC_EMULATE_LAYOUT,
+    VKD3D_DGC_EMULATE_EMIT_FAILED,
+    VKD3D_DGC_EMULATE_REASON_COUNT,
+};
+
+static const char *vkd3d_dgc_emulate_reason_name(enum vkd3d_dgc_emulate_reason r)
+{
+    static const char *names[VKD3D_DGC_EMULATE_REASON_COUNT] =
+    {
+        "ok", "noRootSig", "argCount", "argType", "overBound",
+        "noPushUBO", "notRootConst", "layout", "emitFailed",
+    };
+
+    return names[r];
+}
+
+/* Command-count distribution, so the bound above can be chosen from the shape of
+ * the workload rather than from its extremes. Bucket b holds calls whose
+ * max_command_count fell in [2^b, 2^(b+1)-1] and prints under the bucket's lower
+ * bound. rejectRange only ever reported 65..21341, which says nothing about
+ * whether the mass sits at 70 or at 20000 - and that is exactly the number needed
+ * to trade geometry correctness against recording time. */
+#define VKD3D_DGC_EMULATE_BUCKETS 18u
+
+static void d3d12_dgc_emulate_tally(uint32_t max_command_count,
+        enum vkd3d_dgc_emulate_reason reason)
+{
+    static uint32_t by_reason[VKD3D_DGC_EMULATE_REASON_COUNT];
+    static uint32_t buckets[VKD3D_DGC_EMULATE_BUCKETS];
+    static uint32_t calls, unrolled_cmds, biggest_unrolled;
+    static uint32_t rejected_min, rejected_max;
+    uint32_t i, n, b;
+
+    calls++;
+    by_reason[reason]++;
+
+    for (n = max_command_count, b = 0; n > 1u && b < VKD3D_DGC_EMULATE_BUCKETS - 1u; b++)
+        n >>= 1;
+    buckets[b]++;
+
+    if (reason == VKD3D_DGC_EMULATE_OK)
+    {
+        unrolled_cmds += max_command_count;
+        if (max_command_count > biggest_unrolled)
+            biggest_unrolled = max_command_count;
+    }
+    else
+    {
+        if (!rejected_min || max_command_count < rejected_min)
+            rejected_min = max_command_count;
+        if (max_command_count > rejected_max)
+            rejected_max = max_command_count;
+    }
+
+    if ((calls % 8192u) == 0u)
+    {
+        char reasons[256];
+        char hist[256];
+        size_t off = 0;
+        size_t hoff = 0;
+
+        for (i = 0; i < VKD3D_DGC_EMULATE_REASON_COUNT; i++)
+        {
+            if (!by_reason[i] || off >= sizeof(reasons) - 1)
+                continue;
+            off += snprintf(reasons + off, sizeof(reasons) - off, "%s=%u ",
+                    vkd3d_dgc_emulate_reason_name(i), by_reason[i]);
+        }
+
+        for (i = 0; i < VKD3D_DGC_EMULATE_BUCKETS; i++)
+        {
+            if (!buckets[i] || hoff >= sizeof(hist) - 1)
+                continue;
+            hoff += snprintf(hist + hoff, sizeof(hist) - hoff, "%u:%u ",
+                    1u << i, buckets[i]);
+        }
+
+        ERR("DGC emulate: bound=%u calls=%u cmds=%u (biggest %u) rejectRange %u..%u | %s| hist %s\n",
+                d3d12_dgc_emulate_max_commands(), calls, unrolled_cmds, biggest_unrolled,
+                rejected_min, rejected_max, reasons, hist);
+    }
+}
+
+/* Applies the per-command root constants of a CONSTANT + DRAW[_INDEXED] command
+ * signature on a device without VK_EXT_device_generated_commands, by unrolling
+ * the multi-draw into one draw per command and rebinding the root parameter push
+ * UBO in between. Returns false when the signature or the current root signature
+ * is outside what this can express, leaving the caller to fall back.
+ *
+ * arg_buffer_offset_command is the offset of the start of command 0, i.e. of the
+ * root arguments, not of the draw argument that follows them. */
+static bool d3d12_command_list_execute_indirect_emulate_root_constants(
+        struct d3d12_command_list *list, const struct d3d12_command_signature *sig_impl,
+        uint32_t max_command_count,
+        struct d3d12_resource *arg_impl, uint64_t arg_buffer_offset_command,
+        struct d3d12_resource *count_impl, uint64_t count_buffer_offset)
+{
+    const D3D12_COMMAND_SIGNATURE_DESC *signature_desc = &sig_impl->desc;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    const struct d3d12_root_signature *rs = list->graphics_bindings.root_signature;
+    const struct d3d12_bind_point_layout *bind_point_layout;
+    const struct vkd3d_shader_root_constant *root_constant;
+    const D3D12_INDIRECT_ARGUMENT_DESC *last_arg_desc;
+    const D3D12_INDIRECT_ARGUMENT_DESC *cdesc;
+    struct vkd3d_scratch_allocation args_scratch;
+    struct vkd3d_scratch_allocation root_scratch;
+    struct vkd3d_scratch_allocation block;
+    uint32_t action_words, action_word_offset;
+    uint32_t constant_dest_word, constant_words;
+    static bool warned_no_push_ubo;
+    static bool warned_layout;
+    VkDescriptorBufferInfo buffer_info;
+    VkWriteDescriptorSet write;
+    uint32_t root_block_size;
+    bool indexed;
+    uint32_t i;
+
+    if (!rs)
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_NO_ROOT_SIGNATURE);
+        return false;
+    }
+
+    /* One CONSTANT argument covers 5278 of the 5281 affected signatures this game
+     * creates. Supporting several would mean passing their layout to the shader,
+     * which does not fit the push constant budget, so those keep the fallback. */
+    if (signature_desc->NumArgumentDescs != 2)
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_ARG_COUNT);
+        return false;
+    }
+
+    cdesc = &signature_desc->pArgumentDescs[0];
+    last_arg_desc = &signature_desc->pArgumentDescs[1];
+
+    if (last_arg_desc->Type == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED)
+        indexed = true;
+    else if (last_arg_desc->Type == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW)
+        indexed = false;
+    else
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_ARG_TYPE);
+        return false;
+    }
+
+    if (max_command_count > d3d12_dgc_emulate_max_commands())
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_OVER_BOUND);
+        return false;
+    }
+
+    bind_point_layout = d3d12_root_signature_get_layout(rs, VKD3D_PIPELINE_TYPE_GRAPHICS);
+
+    if (!bind_point_layout ||
+            !(bind_point_layout->flags & VKD3D_ROOT_SIGNATURE_USE_PUSH_CONSTANT_UNIFORM_BLOCK))
+    {
+        /* Without push UBO mode the constants are real Vulkan push constants, and
+         * a value that only exists in device memory cannot reach them at record
+         * time. VKD3D_FORCE_PUSH_UBO=1 moves every root signature over. */
+        if (!warned_no_push_ubo)
+        {
+            warned_no_push_ubo = true;
+            ERR("DGC root constant emulation unavailable: root signature is not in push UBO "
+                    "mode. Set VKD3D_FORCE_PUSH_UBO=1 to enable it.\n");
+        }
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_NO_PUSH_UBO);
+        return false;
+    }
+
+    if (!((rs->root_constant_mask >> cdesc->Constant.RootParameterIndex) & 1))
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_NOT_ROOT_CONSTANT);
+        return false;
+    }
+
+    root_constant = root_signature_get_32bit_constants(rs, cdesc->Constant.RootParameterIndex);
+    constant_dest_word = root_constant->constant_index + cdesc->Constant.DestOffsetIn32BitValues;
+    constant_words = cdesc->Constant.Num32BitValuesToSet;
+
+    action_words = indexed
+            ? sizeof(VkDrawIndexedIndirectCommand) / sizeof(uint32_t)
+            : sizeof(VkDrawIndirectCommand) / sizeof(uint32_t);
+    action_word_offset = sig_impl->argument_buffer_offset_for_command / sizeof(uint32_t);
+
+    if (!constant_words || constant_dest_word + constant_words > D3D12_MAX_ROOT_COST ||
