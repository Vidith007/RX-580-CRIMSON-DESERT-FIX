+            batch_entry->emulate_root_scratch = root_scratch;
+            batch_entry->emulate_counts_scratch = counts_scratch;
+            batch_entry->emulate_indexed = indexed;
+            batch_entry->emulate_action_words = action_words;
+            batch_entry->emulate_patch_inline = patch_inline;
+            return true;
+        }
