+	 * chunk's draw count excludes it and the packet is never fetched, or - with per-chunk
+	 * counts off - it is fetched with the arguments zeroed above, and a draw of zero
+	 * indices runs no vertex or pixel shader. Nothing reads the block either way, so the
+	 * block is pure write traffic, and it is the great majority of this shader's work: 64
+	 * of the 69 words per command, as uncoalesced 4-byte stores at a 256-byte stride.
+	 *
+	 * The game this was written for declares far more commands than it draws - 16384
+	 * against a real count near fifty, and a session total of 3.15 billion declared
+	 * commands - so at 22 fps this was some 80 MB per frame of blocks that nothing could
+	 * ever index. The zeroing of the draw arguments above is deliberately left
+	 * unconditional: that is what makes a surplus command draw nothing when the caller
+	 * falls back to fixed-count draws, which happens whenever the bound pipeline vetoes
+	 * the DrawIndex-indexed blocks, and the patch pass cannot see that veto from here. */
+	if (cmd_active)
+	{
+		/* Start from the root parameter block the command list currently has bound,
+		 * so every root parameter the signature does not name keeps its API value. */
+		uint root_dst = root_block_stride_words * cmd_index;
+
+		for (uint i = 0u; i < root_words; i++)
+			out_root.values[root_dst + i] = root_template.values[i];
+
+		/* The root constants live at the front of the command, ahead of the action
+		 * argument, in the order the signature declared them. */
+		for (uint i = 0u; i < constant_words; i++)
+			out_root.values[root_dst + constant_dest_word + i] = indirect.values[src + i];
+	}
+}
