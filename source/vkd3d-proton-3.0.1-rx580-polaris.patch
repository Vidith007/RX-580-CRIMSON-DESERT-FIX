+/* Where each unrolled ExecuteIndirect managed to put its patch compute, and what that
+ * cost. The number that matters is rpBreak.
+ *
+ * The patch is a compute dispatch, so when it has to be recorded into the main command
+ * buffer the render pass has to end and restart around it, and on this hardware that is a
+ * full pipeline drain. Once per ExecuteIndirect, a few hundred times a frame, that holds
+ * the GPU at high measured occupancy while it never gets enough work in flight to draw
+ * its power budget - which is exactly the shape of a device reporting near-100% busy at a
+ * third of its rated watts. Same racy-by-design accounting as the counters further down:
+ * a torn read costs a slightly wrong diagnostic and nothing else. */
+enum vkd3d_dgc_hoist_outcome
+{
+    VKD3D_DGC_HOIST_OK = 0,     /* patch went in its own command buffer, render pass left alone */
+    VKD3D_DGC_HOIST_INLINE,     /* patch had to go inline, with the drain that implies */
+    VKD3D_DGC_HOIST_SPLIT,      /* a sequence split bought the hoist back */
+    VKD3D_DGC_HOIST_RP_BREAK,   /* render passes this path ended */
+    VKD3D_DGC_HOIST_NO_BUDGET,  /* this list had already spent its split allowance */
+    VKD3D_DGC_HOIST_NO_QUERY,   /* a scoped query or a pending DGC batch forbade the split */
+    VKD3D_DGC_HOIST_FAILED,     /* split attempted and refused anyway - command buffer alloc */
+    VKD3D_DGC_HOIST_REALIAS,    /* INDIRECT_ARGUMENT transitions that re-aliased the buffer */
+    VKD3D_DGC_HOIST_COUNT,
+};
+
+static uint32_t vkd3d_dgc_hoist[VKD3D_DGC_HOIST_COUNT];
+
+static const char *vkd3d_dgc_hoist_outcome_name(enum vkd3d_dgc_hoist_outcome o)
+{
+    static const char *names[VKD3D_DGC_HOIST_COUNT] =
+    {
+        "ok", "inline", "split", "rpBreak", "noBudget", "noQuery", "failed", "realias",
+    };
+
+    return names[o];
+}
+
+/* Kill switch for splitting the command list to win the hoist back. Host-side only, and
+ * deliberately not folded into vkd3d_compute_shader_interface_key(): it changes which
+ * command buffer a dispatch is recorded into and nothing about the emitted SPIR-V, so it
+ * can be A/B'd from the ini without paying for a cold shader recompile. */
+static bool d3d12_dgc_hoist_patch_enabled(void)
+{
+    static int cached = -1;
+    char env[32];
+
+    if (cached < 0)
+    {
+        cached = vkd3d_get_env_var("VKD3D_DGC_HOIST_PATCH", env, sizeof(env))
+                ? strtoul(env, NULL, 0) != 0 : 1;
+    }
+
+    return cached != 0;
+}
+
+/* How many times one command list may split to un-alias its patch command buffer. Each split
+ * costs one more command buffer in the submission, so this is a budget rather than "as often
+ * as possible" - but the default spends the whole compile-time bound, because the thing it is
+ * buying back is a full GPU drain per ExecuteIndirect and that is far more expensive than a
+ * command buffer. Tunable from the ini so the budget can be swept without a rebuild; clamped
+ * to the bound because iterations[] is sized by it. */
+static unsigned int d3d12_dgc_hoist_max_splits(void)
+{
+    static unsigned int cached = ~0u;
+    char env[32];
+
+    if (cached == ~0u)
+    {
+        unsigned int v = VKD3D_MAX_COMMAND_LIST_SEQUENCES - 1;
+
+        if (vkd3d_get_env_var("VKD3D_DGC_HOIST_MAX_SPLITS", env, sizeof(env)))
+        {
+            v = strtoul(env, NULL, 0);
+            if (v > VKD3D_MAX_COMMAND_LIST_SEQUENCES - 1)
+                v = VKD3D_MAX_COMMAND_LIST_SEQUENCES - 1;
+        }
+
+        cached = v;
+    }
+
+    return cached;
+}
+
+/* Kill switch for turning each unrolled chunk into a draw-indirect-COUNT instead of a
+ * fixed-count multi-draw. Host-side only and safe to A/B from the ini: it changes how many
+ * commands the GPU fetches, not what the shaders are, so it costs no shader recompile. */
+static bool d3d12_dgc_count_draw_enabled(void)
+{
+    static int cached = -1;
+    char env[32];
+
+    if (cached < 0)
+    {
+        cached = vkd3d_get_env_var("VKD3D_DGC_COUNT_DRAW", env, sizeof(env))
+                ? strtoul(env, NULL, 0) != 0 : 1;
+    }
+
+    return cached != 0;
+}
+
+/* Emulates the per-command root constants of ExecuteIndirect on a device with no
+ * VK_EXT_device_generated_commands.
+ *
+ * One compute pass builds two buffers:
+ *  - a tightly packed array of single-command draw arguments, with every word
+ *    zeroed past the indirect count so the count buffer stays honoured once the
+ *    multi-draw has been broken up into individual draws
+ *  - one root parameter block per command: the block the command list currently
+ *    has bound, with that command's root constants written over it
+ *
+ * The caller then rebinds the push UBO to block i and issues a one-command
+ * indirect draw for each i. Vulkan cannot source a push constant from a buffer,
+ * so a rebindable uniform buffer is the only channel that can carry a value out
+ * of device memory into both the vertex and the pixel stage.
+ *
+ * When the caller is going to issue the commands in chunks of chunk_blocks and the device
+ * can do draw-indirect-COUNT, the same pass also writes one draw count per chunk. Zeroed
+ * arguments make a command draw nothing, but the command processor still fetches and
+ * retires its packet, and this game declares roughly an order of magnitude more commands
+ * than the count buffer names - so those empty packets, not the real draws, are most of
+ * the front end's work. A count buffer lets whole chunks past the real count be skipped. */
+static bool d3d12_command_list_emit_unroll_draw_indirect(struct d3d12_command_list *list,
+        VkDeviceAddress indirect_args, VkDeviceAddress count_arg,
+        uint32_t stride, uint32_t max_commands,
+        uint32_t action_word_offset, uint32_t action_words,
+        uint32_t constant_dest_word, uint32_t constant_words,
+        uint32_t chunk_blocks,
+        struct vkd3d_scratch_allocation *args_scratch,
+        struct vkd3d_scratch_allocation *root_scratch,
+        struct vkd3d_scratch_allocation *counts_scratch,
+        bool batched, bool *patch_inline)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    union vkd3d_root_parameter_data root_parameter_data;
+    struct vkd3d_unroll_draw_indirect_info pipeline_info;
+    struct vkd3d_scratch_allocation template_scratch;
+    struct vkd3d_unroll_draw_indirect_args args;
+    VkCommandBuffer vk_patch_cmd_buffer;
+    VkMemoryBarrier2 vk_barrier;
+    VkDependencyInfo dep_info;
+    bool emit_counts;
+
+    vkd3d_meta_get_unroll_draw_indirect_pipeline(&list->device->meta_ops, &pipeline_info);
+
+    if (!d3d12_command_allocator_allocate_scratch_memory(list->allocator,
+            VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+            sizeof(uint32_t) * action_words * max_commands, sizeof(uint32_t), ~0u, args_scratch))
+        return false;
+
+    if (!d3d12_command_allocator_allocate_scratch_memory(list->allocator,
+            VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+            sizeof(root_parameter_data) * max_commands,
+            D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, ~0u, root_scratch))
+        return false;
+
+    /* Nothing to count against without a count buffer: every declared command is then a
+     * real one, and the counts would all come back full. Leaving the allocation out keeps
+     * the draw path on its existing fixed-count multi-draw, which is exactly equivalent. */
+    memset(counts_scratch, 0, sizeof(*counts_scratch));
+
+    emit_counts = chunk_blocks > 1 && count_arg && d3d12_dgc_count_draw_enabled() &&
+            list->device->device_info.vulkan_1_2_features.drawIndirectCount;
+
+    if (emit_counts)
+    {
+        uint32_t chunks = (max_commands + chunk_blocks - 1) / chunk_blocks;
+
+        /* Same pool as args_scratch, which is already bound directly as an indirect
+         * buffer below, so the usage flags needed to read this as a draw count are
+         * known to be there. */
+        if (!d3d12_command_allocator_allocate_scratch_memory(list->allocator,
+                VKD3D_SCRATCH_POOL_KIND_DEVICE_STORAGE,
+                sizeof(uint32_t) * chunks, sizeof(uint32_t), ~0u, counts_scratch))
+        {
+            memset(counts_scratch, 0, sizeof(*counts_scratch));
+            emit_counts = false;
+        }
+    }
+
+    /* The compute pass has to read the template, so it goes in host visible
+     * scratch rather than a push constant: the block is 256 bytes and the push
+     * constant budget on this device is 128. */
+    if (!d3d12_command_allocator_allocate_scratch_memory(list->allocator,
+            VKD3D_SCRATCH_POOL_KIND_UNIFORM_UPLOAD, sizeof(root_parameter_data),
+            D3D12_CONSTANT_BUFFER_DATA_PLACEMENT_ALIGNMENT, ~0u, &template_scratch))
+        return false;
+
+    /* Snapshot the root parameter block as the API has it right now, so every
+     * root parameter the command signature does not name keeps its bound value. */
+    memset(&root_parameter_data, 0, sizeof(root_parameter_data));
+    d3d12_command_list_fetch_root_parameter_data(list, &list->graphics_bindings, &root_parameter_data);
+    memcpy(template_scratch.host_ptr, &root_parameter_data, sizeof(root_parameter_data));
+
+    /* Flush pending copies first. Safe to do with a render pass still open: it returns
+     * immediately when nothing is batched, and ends the render pass itself when there is
+     * something, so it only costs a pass break when one was unavoidable anyway. */
+    d3d12_command_list_end_transfer_batch(list);
+
+    /* Find out where the patch compute can go before touching the render pass, because if
+     * it can have a command buffer of its own then the render pass does not have to end at
+     * all - everything below records into vk_patch_cmd_buffer and nothing into the main
+     * one. Upstream ends it first and unconditionally, which spends a pipeline drain on
+     * every single ExecuteIndirect. Allocating here is a no-op when the buffer already
+     * exists or has been aliased onto the main buffer, and it only ever touches a
+     * different command buffer, so it is safe to ask from inside a render pass. */
+    d3d12_command_allocator_allocate_init_post_indirect_command_buffer(list->allocator, list);
+
+    if (list->cmd.vk_post_indirect_barrier_commands == list->cmd.vk_command_buffer)
+    {
+        /* Aliased, so the dispatch has to go inline and the render pass has to end. A
+         * transition to INDIRECT_ARGUMENT did that, and the repair upstream uses for it is
+         * reachable only through a DGC layout object, which a device without
+         * device-generated commands never builds - so left alone, the alias and the drain
+         * last for the rest of the command list.
+         *
+         * Pay the break this call was going to pay anyway, then split the sequence so the
+         * next call gets a real patch buffer and pays nothing.
+         *
+         * The split is what makes this correct rather than merely fast. The patch reads
+         * indirect arguments the application may have written earlier in this same command
+         * buffer, so it cannot simply be hoisted ahead of them. Moving it into the next
+         * iteration preserves the order: a list that observed an indirect argument barrier
+         * is always submitted with each iteration's patch buffer immediately before that
+         * iteration's main buffer, so writes recorded in iteration N still complete before
+         * the patch in iteration N + 1.
+         *
+         * None of that applies when the caller is replaying a batch. The batch flush has
+         * already ended the render pass once, for the whole batch, and emits the single
+         * barrier after the last dispatch itself. Splitting here would be actively wrong
+         * rather than merely wasteful: it would move the remaining dispatches into a new
+         * command buffer while every draw that consumes them goes into the buffer after
+         * that, leaving the barrier on the wrong side of the dispatches it orders.
+         *
+         * The split is also known to be unreachable in this game regardless. Instrumenting
+         * every gate over two full sessions gave noQuery=685325 of 685335 attempts, i.e.
+         * essentially all of them: the engine holds a scoped occlusion query open across
+         * its indirect draws, vkCmdBeginQuery and vkCmdEndQuery have to be in the same
+         * command buffer, so a split there would be illegal. Batching is the repair that
+         * works because it moves the dispatches within one command buffer instead of
+         * between two. */
+        if (!batched)
+        {
+            d3d12_command_list_end_current_render_pass(list, false);
+            vkd3d_dgc_hoist[VKD3D_DGC_HOIST_RP_BREAK]++;
+
+            if (d3d12_dgc_hoist_patch_enabled())
+            {
+                unsigned int iterations = list->cmd.iteration_count;
+
+                /* Deliberately not d3d12_command_list_consider_new_sequence(): that gate also reads
+                 * device->device_has_dgc_templates, and on a device without device-generated
+                 * commands the store that would set it is skipped by an early goto in command
+                 * signature creation - so it is nailed to zero and the split can never happen. That
+                 * flag is only a "does this game use fancy ExecuteIndirect, so is reordering worth
+                 * the extra command buffer?" heuristic, and being inside the ExecuteIndirect
+                 * emulation path answers it yes by construction. The conditions it guards that do
+                 * matter for correctness are checked here instead.
+                 *
+                 * iteration_count is 1 before the first split, so it doubles as "splits spent + 1".
+                 * The render pass has just been ended, so VKD3D_RENDERING_ACTIVE is clear and the
+                 * end_rendering inside begin_new_sequence cannot recurse back into here. */
+                if (iterations > d3d12_dgc_hoist_max_splits())
+                    vkd3d_dgc_hoist[VKD3D_DGC_HOIST_NO_BUDGET]++;
+                else if (!d3d12_command_list_allows_new_sequence(list))
+                    vkd3d_dgc_hoist[VKD3D_DGC_HOIST_NO_QUERY]++;
+                else
+                {
+                    d3d12_command_list_begin_new_sequence(list, false);
+
+                    if (list->cmd.iteration_count != iterations)
+                    {
+                        vkd3d_dgc_hoist[VKD3D_DGC_HOIST_SPLIT]++;
+                        d3d12_command_allocator_allocate_init_post_indirect_command_buffer(list->allocator, list);
+                    }
+                    else
+                    {
+                        /* Only reachable if the command buffer allocation failed, which it already
+                         * logged. Counted separately so it can never be mistaken for a refused gate. */
+                        vkd3d_dgc_hoist[VKD3D_DGC_HOIST_FAILED]++;
+                    }
+                }
+            }
+        }
+    }
+
+    vk_patch_cmd_buffer = list->cmd.vk_post_indirect_barrier_commands;
+
+    if (patch_inline)
+        *patch_inline = vk_patch_cmd_buffer == list->cmd.vk_command_buffer;
+
+    if (vk_patch_cmd_buffer == list->cmd.vk_command_buffer)
+    {
