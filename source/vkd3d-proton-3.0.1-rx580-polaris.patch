+            if (count_draw)
+            {
+                /* chunk is the maximum, and the count the patch pass wrote is how many of
+                 * those the count buffer named - so a chunk entirely past the real count
+                 * fetches nothing at all instead of retiring hundreds of empty packets.
+                 * DrawIndex still numbers from 0 within the command, and the count is the
+                 * fetched value, so blocks[DrawIndex] lines up exactly as before. */
+                VkDeviceSize count_offset = counts_scratch.offset +
+                        (VkDeviceSize)(i / chunk_blocks) * sizeof(uint32_t);
+
+                if (indexed)
+                {
+                    VK_CALL(vkCmdDrawIndexedIndirectCount(list->cmd.vk_command_buffer,
+                            args_scratch.buffer,
+                            args_scratch.offset + (VkDeviceSize)i * action_words * sizeof(uint32_t),
+                            counts_scratch.buffer, count_offset,
+                            chunk, action_words * sizeof(uint32_t)));
+                }
+                else
+                {
+                    VK_CALL(vkCmdDrawIndirectCount(list->cmd.vk_command_buffer,
+                            args_scratch.buffer,
+                            args_scratch.offset + (VkDeviceSize)i * action_words * sizeof(uint32_t),
+                            counts_scratch.buffer, count_offset,
+                            chunk, action_words * sizeof(uint32_t)));
+                }
+            }
+            else if (indexed)
+            {
+                VK_CALL(vkCmdDrawIndexedIndirect(list->cmd.vk_command_buffer, args_scratch.buffer,
+                        args_scratch.offset + (VkDeviceSize)i * action_words * sizeof(uint32_t),
+                        chunk, action_words * sizeof(uint32_t)));
+            }
+            else
+            {
+                VK_CALL(vkCmdDrawIndirect(list->cmd.vk_command_buffer, args_scratch.buffer,
+                        args_scratch.offset + (VkDeviceSize)i * action_words * sizeof(uint32_t),
+                        chunk, action_words * sizeof(uint32_t)));
+            }
+
+            vk_calls += 2;
+        }
+
+        d3d12_dgc_emulate_note_submission(vk_calls, chunk_blocks);
+    }
+    else for (i = 0; i < max_command_count; i++)
+    {
+        block.buffer = root_scratch.buffer;
+        block.offset = root_scratch.offset + (VkDeviceSize)i * root_block_size;
+
+        vk_write_descriptor_set_from_scratch_push_ubo(&write, &buffer_info, &block,
+                root_block_size, rs->push_constant_ubo_binding.binding);
+
+        VK_CALL(vkCmdPushDescriptorSetKHR(list->cmd.vk_command_buffer,
+                VK_PIPELINE_BIND_POINT_GRAPHICS, bind_point_layout->vk_pipeline_layout,
+                rs->root_descriptor_set, 1, &write));
+
+        if (indexed)
+        {
+            VK_CALL(vkCmdDrawIndexedIndirect(list->cmd.vk_command_buffer, args_scratch.buffer,
+                    args_scratch.offset + (VkDeviceSize)i * action_words * sizeof(uint32_t),
+                    1, action_words * sizeof(uint32_t)));
+        }
+        else
+        {
+            VK_CALL(vkCmdDrawIndirect(list->cmd.vk_command_buffer, args_scratch.buffer,
+                    args_scratch.offset + (VkDeviceSize)i * action_words * sizeof(uint32_t),
+                    1, action_words * sizeof(uint32_t)));
+        }
+    }
+
+    if (chunk_blocks <= 1)
+        d3d12_dgc_emulate_note_submission(2u * max_command_count, 0);
+
+    /* The push UBO now holds command N-1's constants, not the API's, so make the
+     * next draw re-emit the root parameter block. */
+    d3d12_command_list_invalidate_root_parameters(list, &list->graphics_bindings, false, NULL);
+
+    return true;
+}
