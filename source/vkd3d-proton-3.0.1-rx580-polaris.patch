+            return d3d12_dgc_multi_draw_veto(VKD3D_DGC_MD_META_INVALID);
+
+        if ((flags & VKD3D_SHADER_META_FLAG_READS_ROOT_CONSTANTS) &&
+                !(flags & VKD3D_SHADER_META_FLAG_ROOT_CONSTANTS_DRAW_INDEXED))
+            return d3d12_dgc_multi_draw_veto(VKD3D_DGC_MD_META_READS);
+    }
