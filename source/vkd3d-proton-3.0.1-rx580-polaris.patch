+#version 450
+#extension GL_EXT_buffer_reference : require
+
+/* Emulates the per-command root constants of ExecuteIndirect on a device with no
+ * VK_EXT_device_generated_commands.
+ *
+ * D3D12 lets a command signature set root arguments per command. Vulkan cannot
+ * source a push constant from a buffer, so the only way to give each command its
+ * own root constants is to give each command its own root parameter block and
+ * rebind a uniform buffer between draws. This shader builds those blocks, and
+ * unrolls the draw arguments into a tightly packed buffer at the same time so the
+ * caller can issue one single-command indirect draw per command.
+ *
+ * Commands at or beyond the indirect count get their arguments zeroed, which is
+ * how the count buffer is emulated once the multi-draw is broken up. Their source
+ * words are never read: the application only has to supply as many commands as
+ * the count buffer names, so reading past it would be an out of bounds fetch
+ * through a raw device address. */
+
+layout(local_size_x = 32) in;
+
+layout(buffer_reference_align = 4, std430, buffer_reference) readonly buffer Indirect
+{
+	uint values[];
+};
+
+layout(buffer_reference_align = 4, std430, buffer_reference) writeonly buffer IndirectOutput
+{
+	uint values[];
+};
+
+layout(buffer_reference_align = 4, std430, buffer_reference) readonly buffer IndirectCount
+{
+	uint value;
+};
+
+layout(buffer_reference_align = 4, std430, buffer_reference) readonly buffer RootTemplate
+{
+	uint values[];
+};
+
+layout(buffer_reference_align = 4, std430, buffer_reference) writeonly buffer RootOutput
+{
+	uint values[];
+};
+
+layout(buffer_reference_align = 4, std430, buffer_reference) writeonly buffer DrawCountOutput
+{
+	uint values[];
+};
+
+layout(push_constant) uniform Registers
+{
+	Indirect indirect;
+	IndirectCount count;
+	IndirectOutput out_args;
+	RootTemplate root_template;
+	RootOutput out_root;
+	DrawCountOutput out_counts;
+	uint stride_words;
+	uint max_commands;
+	uint action_word_offset;
+	uint action_words;
+	uint root_words;
+	uint root_block_stride_words;
+	uint constant_dest_word;
+	uint constant_words;
+	uint has_count;
+	uint chunk_blocks;
+};
+
+void main()
+{
+	uint cmd_index = gl_GlobalInvocationID.x;
+	if (cmd_index >= max_commands)
+		return;
+
+	/* count is a null reference when the application passed no count buffer, so
+	 * this has to be a branch, not a select. */
+	uint indirect_count = max_commands;
+	if (has_count != 0u)
+		indirect_count = count.value;
+
+	bool cmd_active = cmd_index < indirect_count;
+
+	/* One invocation per chunk records how many of that chunk's commands the count
+	 * buffer actually names, so the caller can issue the chunk as a draw-indirect-COUNT
+	 * and the command processor never fetches the ones past it. Zeroing a command's
+	 * arguments makes it draw nothing, but the GPU still fetches and retires the packet,
+	 * and on this game the declared count runs an order of magnitude above the real one -
+	 * so the zeroed commands, not the real ones, are most of the front end's work.
+	 *
+	 * The slots written are exactly the chunk starts the caller will loop over: its loop
+	 * steps by chunk_blocks from 0 while below max_commands, which is the same set as the
+	 * invocations below max_commands whose index divides by chunk_blocks. chunk_blocks is
+	 * 0 when the caller is not going to read this back, and out_counts is then a null
+	 * reference that is never dereferenced. */
+	if (chunk_blocks != 0u && (cmd_index % chunk_blocks) == 0u)
+	{
+		/* The count buffer may name more commands than the call declared; D3D12 takes
+		 * the smaller, and so does the arguments loop above through cmd_active. */
+		uint real = min(indirect_count, max_commands);
+		uint n = 0u;
+		if (real > cmd_index)
+			n = min(real - cmd_index, chunk_blocks);
+		out_counts.values[cmd_index / chunk_blocks] = n;
+	}
+
+	uint src = cmd_index * stride_words;
+	uint arg_dst = action_words * cmd_index;
+
+	for (uint i = 0u; i < action_words; i++)
+	{
+		uint value = 0u;
+		if (cmd_active)
+			value = indirect.values[src + action_word_offset + i];
+		out_args.values[arg_dst + i] = value;
