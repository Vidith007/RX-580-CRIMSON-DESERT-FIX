+/* Applies the per-command root constants of a CONSTANT + DRAW[_INDEXED] command
+ * signature on a device without VK_EXT_device_generated_commands, by unrolling
+ * the multi-draw into one draw per command and rebinding the root parameter push
+ * UBO in between. Returns false when the signature or the current root signature
+ * is outside what this can express, leaving the caller to fall back.
+ *
+ * arg_buffer_offset_command is the offset of the start of command 0, i.e. of the
+ * root arguments, not of the draw argument that follows them.
+ *
+ * mode selects which half of the work to record; see enum vkd3d_ei_emulate_mode.
+ * In VKD3D_EI_EMULATE_TRY_DEFER - which only the application's ExecuteIndirect passes -
+ * the call may instead be deferred into the command list's batch and replayed later in
+ * two passes, which is what stops each call paying its own render pass break and
+ * compute-to-graphics drain; if it is not eligible the mode behaves as ALL. batch_entry
+ * is the entry being filled in or replayed, and is only read or written for the batched
+ * modes. */
+static bool d3d12_command_list_execute_indirect_emulate_root_constants(
+        struct d3d12_command_list *list, struct d3d12_command_signature *sig_impl,
+        uint32_t max_command_count,
+        struct d3d12_resource *arg_impl, uint64_t arg_buffer_offset_command,
+        struct d3d12_resource *count_impl, uint64_t count_buffer_offset,
+        enum vkd3d_ei_emulate_mode mode, struct vkd3d_dgc_batch_draw *batch_entry)
+{
+    const D3D12_COMMAND_SIGNATURE_DESC *signature_desc = &sig_impl->desc;
+    const struct vkd3d_vk_device_procs *vk_procs = &list->device->vk_procs;
+    const struct d3d12_root_signature *rs = list->graphics_bindings.root_signature;
+    const struct d3d12_bind_point_layout *bind_point_layout;
+    const struct vkd3d_shader_root_constant *root_constant;
+    const D3D12_INDIRECT_ARGUMENT_DESC *last_arg_desc;
+    const D3D12_INDIRECT_ARGUMENT_DESC *cdesc;
+    struct vkd3d_scratch_allocation args_scratch;
+    struct vkd3d_scratch_allocation root_scratch;
+    struct vkd3d_scratch_allocation counts_scratch;
+    struct vkd3d_scratch_allocation block;
+    uint32_t action_words, action_word_offset;
+    uint32_t constant_dest_word, constant_words;
+    static bool warned_no_push_ubo;
+    static bool warned_layout;
+    VkDescriptorBufferInfo buffer_info;
+    VkWriteDescriptorSet write;
+    uint32_t root_block_size;
+    uint32_t chunk_blocks;
+    bool patch_inline;
+    bool indexed;
+    uint32_t i;
+
+    if (!rs)
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_NO_ROOT_SIGNATURE);
+        return false;
+    }
+
+    /* One CONSTANT argument covers 5278 of the 5281 affected signatures this game
+     * creates. Supporting several would mean passing their layout to the shader,
+     * which does not fit the push constant budget, so those keep the fallback. */
+    if (signature_desc->NumArgumentDescs != 2)
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_ARG_COUNT);
+        return false;
+    }
+
+    cdesc = &signature_desc->pArgumentDescs[0];
+    last_arg_desc = &signature_desc->pArgumentDescs[1];
+
+    if (last_arg_desc->Type == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW_INDEXED)
+        indexed = true;
+    else if (last_arg_desc->Type == D3D12_INDIRECT_ARGUMENT_TYPE_DRAW)
+        indexed = false;
+    else
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_ARG_TYPE);
+        return false;
+    }
+
+    if (max_command_count > d3d12_dgc_emulate_max_commands())
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_OVER_BOUND);
+        return false;
+    }
+
+    bind_point_layout = d3d12_root_signature_get_layout(rs, VKD3D_PIPELINE_TYPE_GRAPHICS);
+
+    if (!bind_point_layout ||
+            !(bind_point_layout->flags & VKD3D_ROOT_SIGNATURE_USE_PUSH_CONSTANT_UNIFORM_BLOCK))
+    {
+        /* Without push UBO mode the constants are real Vulkan push constants, and
+         * a value that only exists in device memory cannot reach them at record
+         * time. VKD3D_FORCE_PUSH_UBO=1 moves every root signature over. */
+        if (!warned_no_push_ubo)
+        {
+            warned_no_push_ubo = true;
+            ERR("DGC root constant emulation unavailable: root signature is not in push UBO "
+                    "mode. Set VKD3D_FORCE_PUSH_UBO=1 to enable it.\n");
+        }
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_NO_PUSH_UBO);
+        return false;
+    }
+
+    if (!((rs->root_constant_mask >> cdesc->Constant.RootParameterIndex) & 1))
+    {
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_NOT_ROOT_CONSTANT);
+        return false;
+    }
+
+    root_constant = root_signature_get_32bit_constants(rs, cdesc->Constant.RootParameterIndex);
+    constant_dest_word = root_constant->constant_index + cdesc->Constant.DestOffsetIn32BitValues;
+    constant_words = cdesc->Constant.Num32BitValuesToSet;
+
+    action_words = indexed
+            ? sizeof(VkDrawIndexedIndirectCommand) / sizeof(uint32_t)
+            : sizeof(VkDrawIndirectCommand) / sizeof(uint32_t);
+    action_word_offset = sig_impl->argument_buffer_offset_for_command / sizeof(uint32_t);
+
+    if (!constant_words || constant_dest_word + constant_words > D3D12_MAX_ROOT_COST ||
+            (signature_desc->ByteStride % sizeof(uint32_t)) != 0 ||
+            action_word_offset + action_words > signature_desc->ByteStride / sizeof(uint32_t))
+    {
+        if (!warned_layout)
+        {
+            warned_layout = true;
+            ERR("DGC root constant emulation unavailable: unexpected layout "
+                    "(rootParam %u destWord %u words %u stride %u actionOffset %u).\n",
+                    cdesc->Constant.RootParameterIndex, constant_dest_word, constant_words,
+                    signature_desc->ByteStride, action_word_offset);
+        }
+        d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_LAYOUT);
+        return false;
+    }
+
+    if (mode == VKD3D_EI_EMULATE_DRAW)
+    {
+        /* The dispatch that filled these ran in the batch's first pass, with one barrier
+         * after the last of them, so everything below can read them as written. */
+        args_scratch = batch_entry->emulate_args_scratch;
+        root_scratch = batch_entry->emulate_root_scratch;
+        counts_scratch = batch_entry->emulate_counts_scratch;
+    }
+    else
+    {
+        /* Defer instead of recording, so a run of consecutive ExecuteIndirect calls can put
+         * all its dispatches first and all its draws afterwards, and pay one drain for the
+         * run instead of one per call. Every command that could observe the draws - any
+         * direct draw or dispatch, any barrier, copy, clear, query or render target change -
+         * flushes the batch before it does anything, so deferring cannot reorder the draws
+         * against anything that can tell. The state setters that do not flush are exactly
+         * the ones whose effect is captured in the entry and restored on replay.
+         *
+         * Not attempted while predication is armed: the predicate would have to be
+         * re-established per entry on replay, and predication on this path is rare enough
+         * that the complexity is not worth it. A compute pipeline cannot be here either -
+         * the entry's state is dereferenced as a graphics pipeline on replay.
+         *
+         * TRY_DEFER and not ALL: only the application's own call may defer. See the comment
+         * on the mode enum for why replaying a deferral is a hang rather than a no-op. */
+        if (mode == VKD3D_EI_EMULATE_TRY_DEFER && d3d12_dgc_emulate_batch_enabled() &&
+                !list->predication.va && list->state &&
+                list->state->pipeline_type != VKD3D_PIPELINE_TYPE_COMPUTE)
+        {
+            struct vkd3d_dgc_batch_draw *entry;
+
+            vkd3d_array_reserve((void **)&list->dgc_batch.draws, &list->dgc_batch.draws_size,
+                    list->dgc_batch.draws_count + 1, sizeof(*list->dgc_batch.draws));
+            entry = &list->dgc_batch.draws[list->dgc_batch.draws_count++];
+
+            memset(entry, 0, sizeof(*entry));
+            entry->emulate = true;
+            entry->signature = sig_impl;
+            entry->max_command_count = max_command_count;
+            entry->arg_buffer = arg_impl;
+            entry->arg_buffer_offset = arg_buffer_offset_command;
+            entry->count_buffer = count_impl;
+            entry->count_buffer_offset = count_buffer_offset;
+            entry->state = list->state;
+            entry->dynamic_state = list->dynamic_state;
+            entry->graphics_bindings = list->graphics_bindings;
+            entry->index_buffer = list->index_buffer;
+
+            vkd3d_ei_batch_stat[VKD3D_EI_BATCH_DEFERRED]++;
+
+            /* Cap how far the batch may grow. vkd3d_dgc_batch_draw is around 5 KB - it
+             * carries a whole dynamic state block and a whole root parameter binding block -
+             * and vkd3d_array_reserve never gives the memory back, so an uncapped batch sets
+             * a high water mark per command list that the list then keeps. The saving being
+             * bought here is one pipeline drain per batch instead of one per call, and by a
+             * few hundred entries that is already a two-order-of-magnitude cut; letting the
+             * batch run to thousands would buy a rounding error and cost megabytes per list.
+             * Flushing at the cap keeps the win and bounds the footprint. */
+            if (list->dgc_batch.draws_count >= VKD3D_EI_EMULATE_BATCH_MAX)
+            {
+                vkd3d_ei_batch_stat[VKD3D_EI_BATCH_CAPPED]++;
+                d3d12_command_list_flush_dgc_batch(list);
+            }
+
+            return true;
+        }
+
+        vkd3d_ei_batch_stat[VKD3D_EI_BATCH_INLINE]++;
+
+        /* The chunk size the draws below will use, asked of the device rather than of the
+         * bound pipeline so the patch pass and the draw pass cannot disagree. A pipeline
+         * veto only ever turns the chunking off, and that case falls back to fixed-count
+         * draws which ignore the counts entirely, so over-writing them costs a few words
+         * of scratch and nothing else. */
+        chunk_blocks = d3d12_dgc_emulate_multi_draw_blocks_limit(list->device);
+
+        if (!d3d12_command_list_emit_unroll_draw_indirect(list,
+                arg_impl->res.va + arg_buffer_offset_command,
+                count_impl ? count_impl->res.va + count_buffer_offset : 0,
+                signature_desc->ByteStride, max_command_count,
+                action_word_offset, action_words,
+                constant_dest_word, constant_words, chunk_blocks,
+                &args_scratch, &root_scratch, &counts_scratch,
+                mode == VKD3D_EI_EMULATE_PATCH, &patch_inline))
+        {
+            d3d12_dgc_emulate_tally(max_command_count, VKD3D_DGC_EMULATE_EMIT_FAILED);
+            return false;
+        }
